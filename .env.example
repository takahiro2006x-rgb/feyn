# このファイルを .env にコピーして、実際の値を入れてください（.envはgit管理対象外）
# cp .env.example .env

# 必須: Google AI StudioでGeminiのAPIキーを発行 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 必須: Flaskのセッション署名用シークレット。適当なランダム文字列でOK
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# 任意: Geminiの無料枠を使い切ったときの最終フォールバック（無くても動く）
# https://console.groq.com/keys
GROQ_API_KEY=

# 任意: 先生アカウントとして新規登録するときに入力する合言葉（未設定ならデフォルト値が使われる）
TEACHER_CODE=FEYN_TEACHER_2024

# 任意: 本番相当のPostgres(Supabase等)を使う場合のみ設定。未設定ならSQLite(feyn.db)を使う
DATABASE_URL=

# 任意: 決済機能（Stripe）を試す場合のみ。Stripeダッシュボード → 開発者 → APIキー から取得
# https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
